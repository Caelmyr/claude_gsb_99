{
  "rule": {
    "id": "rule_login_freq",
    "name": "登录高频检测",
    "description": "同一 IP 60 秒内登录次数超过 5 次视为撞库/暴力破解",
    "enabled": true,
    "priority": 100,
    "conditions": [
      {
        "field": "type",
        "op": "==",
        "value": "login"
      },
      {
        "agg": {
          "window_sec": 60,
          "key_field": "ip",
          "op": ">=",
          "threshold": 5,
          "agg_type": "count"
        }
      }
    ],
    "action": {
      "type": "reject",
      "risk_score": 90,
      "reason": "登录频率过高",
      "level": "高"
    },
    "tags": [
      "高频",
      "登录"
    ],
    "version": 4,
    "updated_at": 1790311647
  }
}