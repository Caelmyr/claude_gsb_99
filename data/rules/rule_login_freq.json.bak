{
  "rule": {
    "id": "rule_login_freq",
    "name": "登录高频检测",
    "description": "窗口放宽到 120 秒、阈值 6",
    "enabled": true,
    "priority": 100,
    "conditions": [
      {
        "field": "type",
        "op": "==",
        "value": "login"
      },
      {
        "agg": {
          "window_sec": 120,
          "key_field": "ip",
          "op": ">=",
          "threshold": 6,
          "agg_type": "count"
        }
      }
    ],
    "action": {
      "type": "reject",
      "risk_score": 90,
      "reason": "登录频率过高",
      "level": "高"
    },
    "tags": [
      "高频",
      "登录"
    ],
    "version": 3,
    "updated_at": 1790311647
  }
}