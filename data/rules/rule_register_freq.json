{
  "rule": {
    "id": "rule_register_freq",
    "name": "注册高频检测",
    "description": "同一 IP 60 秒内注册超过 3 次视为批量注册",
    "enabled": true,
    "priority": 85,
    "conditions": [
      {
        "field": "type",
        "op": "==",
        "value": "register"
      },
      {
        "agg": {
          "window_sec": 60,
          "key_field": "ip",
          "op": ">=",
          "threshold": 3,
          "agg_type": "count"
        }
      }
    ],
    "action": {
      "type": "reject",
      "risk_score": 88,
      "reason": "注册频率过高",
      "level": "高"
    },
    "tags": [
      "高频",
      "注册"
    ],
    "version": 1,
    "updated_at": 1790311647
  }
}